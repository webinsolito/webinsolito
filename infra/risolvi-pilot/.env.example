# Public endpoint. Point DNS here before starting Caddy.
RISOLVI_DOMAIN=pilot.example.org

# Release identity. deploy.sh overrides this with `git rev-parse HEAD`.
RISOLVI_BUILD_SHA=0000000000000000000000000000000000000000

# PostgreSQL. Generate a long random password.
POSTGRES_USER=risolvi
POSTGRES_DB=risolvi
POSTGRES_PASSWORD=replace-with-long-random-postgres-password

# App capability/auth secrets. Never commit real values.
RISOLVI_CAPABILITY_SECRET=replace-with-at-least-32-random-characters
RISOLVI_REVIEWER_CREDENTIALS_JSON={"rev-pilot":"replace-with-at-least-32-random-characters"}
RISOLVI_SMOKE_REVIEWER_ID=rev-pilot
RISOLVI_SMOKE_REVIEWER_SECRET=replace-with-same-reviewer-secret-used-above

# Pilot must start CLOSED. smoke.sh opens intake only for the synthetic smoke and closes it in a trap.
RISOLVI_PILOT_INTAKE_ENABLED=false
RISOLVI_ALLOWED_ORIGINS=https://pilot.example.org

# Retention defaults for the supervised pilot.
RISOLVI_CASE_RETENTION_DAYS=7
RISOLVI_DOCUMENT_RETENTION_HOURS=24
RISOLVI_SIGNED_URL_SECONDS=300
RISOLVI_CLAMAV_TIMEOUT_SECONDS=10

# Dedicated S3-compatible object storage. Prefer a provider bucket in an EU region.
RISOLVI_S3_BUCKET=risolvi-pilot-private
RISOLVI_S3_REGION=eu-central-1
RISOLVI_S3_ENDPOINT_URL=https://s3.example.invalid
RISOLVI_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=replace-with-dedicated-access-key
AWS_SECRET_ACCESS_KEY=replace-with-dedicated-secret-key

# Optional self-hosted S3 profile for a single-VM pilot.
# If used, set RISOLVI_S3_ENDPOINT_URL=http://minio:9000 and RISOLVI_S3_FORCE_PATH_STYLE=true.
# Pin images by digest before a real pilot instead of relying on `latest`.
RISOLVI_MINIO_IMAGE=minio/minio:latest
RISOLVI_MINIO_MC_IMAGE=minio/mc:latest
