# Runtime
RISOLVI_ENV=production
RISOLVI_AUTO_CREATE_SCHEMA=false
RISOLVI_PILOT_ENABLED=true
# Keep intake CLOSED through deploy, migrations, preflight and synthetic smoke tests.
# Open only after operational + legal gates are explicitly satisfied.
RISOLVI_PILOT_INTAKE_ENABLED=false
RISOLVI_PILOT_NOTICE_VERSION=pilot-2026-10-v1

# Secrets: generate independently, >= 32 random bytes/characters.
RISOLVI_CAPABILITY_SECRET=replace-with-random-secret
# Production pilot requires one distinct credential per pseudonymous reviewer ID.
# IDs: 3-64 chars, lowercase a-z / 0-9 / . _ - ; do not use names or email addresses.
# Tokens must be distinct and >= 32 characters. Keep this JSON server-side only.
RISOLVI_REVIEWER_CREDENTIALS_JSON={"rev-01":"replace-with-random-reviewer-01-secret","rev-02":"replace-with-random-reviewer-02-secret"}

# Dedicated PostgreSQL database. Do not reuse another WEBINSOLITO product database.
# Runtime can use a session-pooler URL when the application host is IPv4-only.
RISOLVI_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RUNTIME_HOST:5432/DBNAME?sslmode=require
# Alembic should use a direct DB endpoint where the provider recommends it.
# If omitted, migrations fall back to RISOLVI_DATABASE_URL.
RISOLVI_MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST:5432/DBNAME?sslmode=require

# Explicit browser origins only. Never use *.
RISOLVI_ALLOWED_ORIGINS=https://www.webinsolito.it,https://review.webinsolito.it

# Retention
RISOLVI_CASE_RETENTION_DAYS=7
RISOLVI_DOCUMENT_RETENTION_HOURS=24
RISOLVI_SIGNED_URL_SECONDS=300

# Malware gate. Production refuses to start without a real scanner.
# clamd must only be reachable on the private service network, never exposed publicly.
RISOLVI_MALWARE_SCANNER=clamav
RISOLVI_CLAMAV_HOST=clamav
RISOLVI_CLAMAV_PORT=3310
RISOLVI_CLAMAV_TIMEOUT_SECONDS=10

# Private S3-compatible object storage.
# For Supabase Storage use the S3 endpoint from project settings and path-style addressing.
RISOLVI_STORAGE_BACKEND=s3
RISOLVI_S3_BUCKET=replace-with-private-bucket
RISOLVI_S3_REGION=replace-with-provider-region
RISOLVI_S3_ENDPOINT_URL=https://replace-with-s3-endpoint
RISOLVI_S3_FORCE_PATH_STYLE=true
# Server-only S3 credentials. Never expose these in risolvi/ or risolvi-review/ assets.
AWS_ACCESS_KEY_ID=replace-with-storage-key-id
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret
