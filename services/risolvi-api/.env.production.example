# Runtime
RISOLVI_ENV=production
RISOLVI_AUTO_CREATE_SCHEMA=false
RISOLVI_PILOT_ENABLED=true
RISOLVI_PILOT_NOTICE_VERSION=pilot-2026-10-v1

# Secrets: generate independently, >= 32 random bytes/characters.
RISOLVI_CAPABILITY_SECRET=replace-with-random-secret
RISOLVI_REVIEWER_SECRET=replace-with-different-random-secret

# Dedicated PostgreSQL database. Do not reuse another WEBINSOLITO product database.
RISOLVI_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Explicit browser origins only. Never use *.
RISOLVI_ALLOWED_ORIGINS=https://www.webinsolito.it,https://review.webinsolito.it

# Retention
RISOLVI_CASE_RETENTION_DAYS=7
RISOLVI_DOCUMENT_RETENTION_HOURS=24
RISOLVI_SIGNED_URL_SECONDS=300

# Private S3-compatible object storage
RISOLVI_STORAGE_BACKEND=s3
RISOLVI_S3_BUCKET=replace-with-private-bucket
RISOLVI_S3_REGION=eu-central-1
RISOLVI_S3_ENDPOINT_URL=https://replace-with-s3-endpoint
AWS_ACCESS_KEY_ID=replace-with-storage-key-id
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret
